# Dynamo environment configuration.
# Copy to .env (never commit .env). One file per environment: .env.dev / .env.test / .env.paper / .env.live
# Secrets management design: docs/design/12-operations.md

# --- Environment: DEV | TEST | PAPER | LIVE ---
DYNAMO_ENV=DEV

# --- Database ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://dynamo:change-me@localhost:5432/dynamo_dev

# --- Anthropic (research committee) ---
ANTHROPIC_API_KEY=
CLAUDE_MONTHLY_BUDGET_USD=90        # hard kill-switch ceiling, see docs/design/03-claude-committee.md

# --- Broker: Alpaca (paper first; live requires DYNAMO_ENV=LIVE + signed approval artifact) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Market data ---
TIINGO_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
EDGAR_USER_AGENT="Dynamo research sailokesh.kolla@gmail.com"   # SEC requires a declared UA

# --- Prediction markets (read-only research) ---
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Polymarket Gamma/CLOB read endpoints need no key

# --- Approval signing key (doc 08 section 7 stage 7 + doc 09 section 7) ---
# DYNAMO_APPROVAL_KEY is DELIBERATELY ABSENT from this file and from .env.
# It is the HMAC key that makes a human approval unforgeable; keeping it in
# the working tree next to approvals/ would make the gate theatre. Generate
# it with `python -m dynamo.cli.approve keygen`, store it in a password
# manager, and export it from your shell profile. See approvals/README.md.

# --- Alerting (M6) ---
# Telegram is the page channel (docs/design/12-operations.md section 7). Leave
# both blank and the notifier degrades to a single WARNING log line per
# process and never raises -- alerts still land in the `alerts` table.
# Bot token from @BotFather; chat id from
#   curl https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Minimum severity that is actually sent (info | warn | page). Default: page.
DYNAMO_NOTIFY_MIN_SEVERITY=page
# Dead-man switch (docs/runbooks/batch-failure.md): healthcheck_job pings this
# URL at 02:30 ET after the nightly chain. A Healthchecks.io check with ~2h
# grace turns "the nightly silently never ran" into a page. Unset = the ping
# is skipped and NOTHING detects a dead nightly.
HEALTHCHECK_URL=

# --- Risk limits (doc 06 section 11: versioned config, not source edits) ---
# Path to a YAML/JSON file of RiskConfig field overrides; relative paths
# anchor to $DYNAMO_HOME. Unset = the documented defaults in
# domain/models/risk.py, reported by /risk/limits as version "default".
# A path that does not exist REFUSES to start -- running on defaults while
# you believe an override is live is the failure this prevents.
# DYNAMO_RISK_CONFIG=config/risk.yaml
# doc 06 section 2 risk bucket: low | medium | high (0.6x / 1.0x / 1.4x on
# the per-name risk budget; never on gross_cap, cash_floor, or any *_hard).
DYNAMO_RISK_BUCKET=medium

# --- Kill switch ---
# The one file every process checks. RELATIVE paths are resolved against
# $DYNAMO_HOME (default: the repo root), NOT the process CWD -- so the Dagster
# daemon, the API and your shell all agree on one file. Set an absolute path
# here if the runtime home differs from the checkout.
DYNAMO_KILL_SWITCH_PATH=KILL_SWITCH
# DYNAMO_HOME=/srv/dynamo

# --- Free upgrades ---
ALPHAVANTAGE_API_KEY=
ODDSPIPE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Polymarket live execution (ADR-0012; reads stay keyless via Gamma) ---
# The CLOB L2 credentials AUTHENTICATE API calls; the wallet key SIGNS orders
# (EIP-712). Real orders additionally require DYNAMO_ENV=LIVE +
# polymarket_live_enabled + a signed live approval artifact — anything
# missing falls back to the ADR-0011 simulated sleeve (never the reverse).
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
# Path to a file in secrets/ (gitignored) holding the Polygon wallet private
# key. Never commit the key or paste it into an env value.
POLYMARKET_WALLET_KEY_PATH=
# Proxy ("funder") address holding the USDC — required for signature types
# 1 (email/Magic proxy, the default) and 2 (browser-wallet proxy); 0 = EOA.
POLYMARKET_FUNDER_ADDRESS=
