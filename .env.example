# Dynamo environment configuration.
# Copy to .env (never commit .env). One file per environment: .env.dev / .env.test / .env.paper / .env.live
# Secrets management design: docs/design/12-operations.md

# --- Environment: DEV | TEST | PAPER | LIVE ---
DYNAMO_ENV=DEV

# --- Database ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://dynamo:change-me@localhost:5432/dynamo_dev

# --- Anthropic (research committee) ---
ANTHROPIC_API_KEY=
CLAUDE_MONTHLY_BUDGET_USD=90        # hard kill-switch ceiling, see docs/design/03-claude-committee.md

# --- Broker: Alpaca (paper first; live requires DYNAMO_ENV=LIVE + signed approval artifact) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Market data ---
TIINGO_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
EDGAR_USER_AGENT="Dynamo research sailokesh.kolla@gmail.com"   # SEC requires a declared UA

# --- Prediction markets (read-only research) ---
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Polymarket Gamma/CLOB read endpoints need no key

# --- Alerting (M6) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Free upgrades ---
ALPHAVANTAGE_API_KEY=
ODDSPIPE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Polymarket live execution (ADR-0012; reads stay keyless via Gamma) ---
# The CLOB L2 credentials AUTHENTICATE API calls; the wallet key SIGNS orders
# (EIP-712). Real orders additionally require DYNAMO_ENV=LIVE +
# polymarket_live_enabled + a signed live approval artifact — anything
# missing falls back to the ADR-0011 simulated sleeve (never the reverse).
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
# Path to a file in secrets/ (gitignored) holding the Polygon wallet private
# key. Never commit the key or paste it into an env value.
POLYMARKET_WALLET_KEY_PATH=
# Proxy ("funder") address holding the USDC — required for signature types
# 1 (email/Magic proxy, the default) and 2 (browser-wallet proxy); 0 = EOA.
POLYMARKET_FUNDER_ADDRESS=
