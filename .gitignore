# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Env & secrets — only .env.example is committed
.env
.env.*
!.env.example

# Data & artifacts (repo-root data dir only; src/dynamo/data is source code)
/data/
*.parquet
*.duckdb
models/artifacts/
# Model artifacts (Settings().artifact_dir default: repo-root artifacts/)
/artifacts/
*.joblib

# OS / editor
.DS_Store
.idea/
.vscode/

# Dagster
.dagster_home/

# Private keys (Kalshi etc.) — never committed
secrets/

# Signed approval artifacts (approvals/README.md): operational acts with an
# expiry, not source. The signing key ($DYNAMO_APPROVAL_KEY) never lives here.
/approvals/*
!/approvals/README.md

# pg_dump archives (docs/runbooks/db-restore.md). Backups belong in object
# storage, never in git.
/backups/

# Dagster scratch home, created when a CLI invocation runs without DAGSTER_HOME
.tmp_dagster_home_*/
